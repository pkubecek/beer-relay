# SQLite lokálně. Na Railway připoj volume (např. na /data) a nastav:
#   DATABASE_URL=sqlite:////data/beerrelay.db
DATABASE_URL=sqlite:///./beerrelay.db

# Tajný klíč pro podepisování JWT tokenů – ZMĚŇ v produkci na náhodný dlouhý řetězec!
SECRET_KEY=change-me-in-production-please

# E-maily (čárkou oddělené), které po registraci/přihlášení automaticky dostanou roli admin
ADMIN_EMAILS=tvuj@email.cz

# Časové pásmo pro uzávěrky přihlášek
APP_TIMEZONE=Europe/Prague

# Adresy, ze kterých smí frontend volat API (čárkou oddělený seznam)
ALLOWED_ORIGINS=http://localhost:5173,https://tvuj-frontend.vercel.app

# Dokumentace API na /docs – lokálně klidně 1, v produkci (Railway) nenastavuj
ENABLE_DOCS=1
